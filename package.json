    "coverage:pob": "tsx scripts/coverage/pob-extract.ts",
    "coverage:draft": "tsx scripts/coverage/draft.ts",
    "coverage:wiki": "tsx scripts/coverage/wiki-page.ts",
    "coverage:bases": "tsx scripts/coverage/pob-bases.ts",
