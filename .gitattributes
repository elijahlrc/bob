# Normalize text files to LF in the repo so Windows/macOS/Linux checkouts don't churn.
* text=auto eol=lf

# Game assets: never diff or convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.ogg binary
*.wav binary
*.ttf binary
*.woff binary
*.woff2 binary
